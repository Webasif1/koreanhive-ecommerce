# Copy to .env and fill in. Never commit .env.

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database ---
# Neon: copy the pooled connection string from the Neon dashboard.
# Use sslmode=verify-full explicitly — pg v9 will weaken what plain
# `require` means, and Neon presents a publicly trusted certificate.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# --- Admin (Auth.js) ---
# Generate a secret with: npx auth secret
# AUTH_SECRET=""
# Used once by `npm run admin:create` to seed the staff login.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# --- Meilisearch (later) ---
# MEILISEARCH_HOST=""
# MEILISEARCH_MASTER_KEY=""

# --- ImageKit (later) ---
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""
# IMAGEKIT_PUBLIC_KEY=""
# IMAGEKIT_PRIVATE_KEY=""

# --- SSLCommerz (later) ---
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
