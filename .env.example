# Copy to .env and fill in. Never commit .env.

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (MongoDB) ---
# Atlas: Database > Connect > Drivers. Include the database name in the path.
# A replica set is required for checkout's multi-document transaction —
# Atlas is one by default, a standalone local mongod is not.
# MONGODB_URI=""

# Only needed while moving between clusters. `npm run db:migrate` copies
# every collection from MONGODB_URI_OLD into MONGODB_URI; run it with
# --dry-run first. Remove this once the new cluster is verified.
# MONGODB_URI_OLD=""

# --- Admin (Auth.js) ---
# Generate a secret with: npx auth secret
# AUTH_SECRET=""
# Used once by `npm run admin:create` to seed the staff login.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# --- Product catalogue ---
# The Google Sheet that is the source of truth for products, shared as
# "anyone with the link can view". Configuration, not a secret — it lives here
# so the catalogue source can move without a code change.
# Used by `npm run catalogue:sync`; the same link works in /admin/products/import.
# SHEET_CSV_URL=""

# --- Meta Pixel / Conversions API ---
# GTM (GTM-TVQKLMGJ) loads the browser pixel; these drive the server-side
# events in src/server/tracking/meta-capi.ts. Set them on the server (cPanel →
# Setup Node.js App → Environment variables) and never commit the token.
# Without META_CAPI_ACCESS_TOKEN the server side is skipped; the pixel still runs.
# META_PIXEL_ID="1546290089781447"
# Events Manager → Korean Hive → Settings → Conversions API → Generate access token
# META_CAPI_ACCESS_TOKEN=""
# Only while testing (Events Manager → Test events). Remove afterwards.
# META_TEST_EVENT_CODE=""
# META_GRAPH_API_VERSION="v25.0"

# --- Chat assistant (Gemini) ---
# Optional. Without it the advisor runs on its rule engine exactly as before —
# the key adds natural-language understanding and Bangla/Banglish replies.
# Get one at https://aistudio.google.com/apikey
# Server-side only: never prefix this NEXT_PUBLIC_, or it ships to the browser.
# GEMINI_API_KEY=""

# --- Order emails (Gmail SMTP) ---
# The shop Gmail that sends order emails — a new-order heads-up to the shop,
# and to customers who gave an email: placed, confirmed, shipped, delivered.
# The password is a Google *app password* (Google Account → Security →
# 2-Step Verification → App passwords), never the account's real password.
# Without both, orders still work and emails are skipped.
# GOOGLE_USER_EMAIL=""
# GOOGLE_USER_PASSWORD=""
# Optional: send the shop copies somewhere other than GOOGLE_USER_EMAIL.
# ORDER_NOTIFY_EMAIL=""
# PRODUCTION: the cPanel server's firewall refuses connections to Gmail, so
# the live site sends through the host's own mail server instead, from a
# cPanel mailbox (cPanel → Email Accounts → e.g. orders@koreanhive.com).
# Set these on the server; they take precedence over GOOGLE_USER_*.
# Replies still go to ORDER_NOTIFY_EMAIL.
# SMTP_HOST="localhost"
# SMTP_USER="orders@koreanhive.com"
# SMTP_PASS=""
# SMTP_TLS_SERVERNAME="mail.koreanhive.com"
# ORDER_NOTIFY_EMAIL="koreanhives@gmail.com"
# Optional: pin one port (465 implicit TLS, 587 STARTTLS). Unset tries both.
# SMTP_PORT="465"

# --- Meilisearch (later) ---
# MEILISEARCH_HOST=""
# MEILISEARCH_MASTER_KEY=""

# --- ImageKit (later) ---
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""
# IMAGEKIT_PUBLIC_KEY=""
# IMAGEKIT_PRIVATE_KEY=""

# --- SSLCommerz (later) ---
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""

# ---------------------------------------------------------------- contact
# Published on /contact and used in the Organization JSON-LD. Only the
# channels you set are rendered — leave one blank rather than shipping an
# address nobody reads.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ------------------------------------------------------------------ proxy
# How many trusted proxies sit in front of the app. Rate limiting reads the
# client address this many hops from the right of X-Forwarded-For, so a
# client cannot mint itself a fresh budget by sending its own header.
# REQUIRED IN PRODUCTION. Defaults to 0 = trust no client-supplied address,
# because believing a header just because it is present is how the bypass
# worked in the first place. While it is 0, per-IP rate limiting is disabled
# (the login's per-email limit still applies) and the server logs a warning
# once.
# 1 = one reverse proxy (nginx/Caddy in front of the container).
# 2 = CDN in front of a load balancer.
TRUSTED_PROXY_HOPS=1
