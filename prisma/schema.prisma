// Korean Hive — data model
//
// Money: every amount is an Int in whole Bangladeshi taka (৳). BDT retail
// does not price in poisha, and Int keeps values serialisable across the
// Server/Client Component boundary without Decimal.toString() gymnastics.
//
// Guest-first: Order carries its own customer fields and userId is optional,
// so checkout never requires an account. Tracking uses orderNumber + phone.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  SSLCOMMERZ
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ---------------------------------------------------------------- people

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  role          Role      @default(CUSTOMER)
  /// scrypt hash, "salt:key" hex. Only staff accounts have one — customers
  /// stay guest-first and will sign in by phone OTP later.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  addressLine   String
  area          String
  district      String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryZoneId String?

  @@index([userId])
}

// --------------------------------------------------------------- catalog

model Brand {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  logoUrl         String?
  countryOfOrigin String?  @default("South Korea")
  isActive        Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]
}

model Category {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  imageUrl        String?
  position        Int      @default(0)
  isActive        Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // self-relation: Skincare > Cleansers > Oil Cleansers
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
}

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  shortDescription String?
  description      String?
  ingredients      String?
  howToUse         String?

  /// selling price in whole BDT
  price Int
  /// struck-through "was" price, in whole BDT
  comparePrice Int?

  sku        String? @unique
  stock      Int     @default(0)
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  /// denormalised review aggregates, refreshed when a review is approved
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([isActive, createdAt])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String
  sku       String? @unique
  /// overrides Product.price when set, in whole BDT
  price     Int?
  stock     Int     @default(0)
  position  Int     @default(0)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// -------------------------------------------------------------- commerce

model DeliveryZone {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  /// flat delivery charge in whole BDT
  charge   Int
  /// order subtotal above which delivery is free; null = never free
  freeShippingThreshold Int?
  minDays  Int     @default(1)
  maxDays  Int     @default(3)
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType
  /// PERCENTAGE: 0-100. FIXED: whole BDT off.
  value       Int
  minSubtotal Int?
  /// caps a PERCENTAGE discount, in whole BDT
  maxDiscount Int?
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Order {
  id          String @id @default(cuid())
  /// human-facing, e.g. KH-260730-8FQ2
  orderNumber String @unique

  // guest-first: userId stays null for guest checkout
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String
  customerEmail String?

  addressLine String
  area        String
  district    String
  postalCode  String?
  note        String?

  deliveryZoneId String
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// snapshot, survives coupon deletion
  couponCode String?

  subtotal       Int
  discount       Int @default(0)
  shippingCharge Int
  total          Int

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  // /track looks up orderNumber + phone
  @@index([customerPhone])
  @@index([status, createdAt])
  @@index([userId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // references go null if the catalogue entry is deleted; the snapshot below
  // is what the customer actually bought and must never change
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  productSlug String
  variantName String?
  imageUrl    String?

  unitPrice Int
  quantity  Int
  lineTotal Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  OrderStatus
  note    String?
  /// admin name or "system"
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([orderId])
}

model Banner {
  id       String  @id @default(cuid())
  title    String
  subtitle String?
  imageUrl String
  linkUrl  String?
  /// optional call-to-action text; falls back to a default in the UI
  ctaLabel String?
  position Int     @default(0)
  isActive Boolean @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// ------------------------------------------------------ social & saved

model Review {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // guest reviews allowed, so userId is optional
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName String
  phone      String?
  /// 1-5
  rating     Int
  title      String?
  body       String?
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isApproved])
}

model WishlistItem {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// cookie value for guests who have not signed in
  guestToken String?

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([guestToken, productId])
  @@index([productId])
}
